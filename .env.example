# Copier ce fichier en .env.local et renseigner les vraies valeurs.
# Ne jamais commit .env.local (déjà exclu par .gitignore).
#
# Tant que ces variables ne sont pas définies, les formulaires du site
# (contact et estimation propriétaire) valident et journalisent bien les
# demandes côté serveur, mais AUCUN email n'est envoyé : voir lib/mail.ts.

# Clé API Resend (https://resend.com) pour l'envoi des emails de leads.
RESEND_API_KEY=

# Adresse qui reçoit les demandes (boîte de l'équipe Belle Saisons).
CONTACT_EMAIL_TO=

# Adresse d'expédition, doit appartenir à un domaine vérifié dans Resend.
CONTACT_EMAIL_FROM=

# Domaine définitif du site (sans slash final), utilisé pour toutes les
# URLs générées (canonical, sitemap, OpenGraph, JSON-LD...). Si absent,
# retombe sur https://www.belle-saisons.fr — jamais sur localhost.
NEXT_PUBLIC_SITE_URL=https://www.belle-saisons.fr

# Domaine Plausible (https://plausible.io) pour activer l'analytics.
# Laisser vide désactive tout traceur : voir lib/analytics.ts.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Jetons de vérification Google Search Console / Bing Webmaster Tools.
# Laisser vide tant qu'ils ne sont pas générés — ne jamais inventer de
# valeur ici. Une fois obtenus depuis les consoles respectives, coller
# uniquement le code de vérification (pas la balise HTML complète).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Active la route de test email contrôlé (GET /api/dev/test-email?to=...),
# qui envoie les 4 gabarits réels (lead + confirmation, propriétaire et
# contact) pour vérifier rendu HTML, échappement et Reply-To. Toujours
# inactive en production (voir app/api/dev/test-email/route.ts), quelle
# que soit la valeur de cette variable. Voir docs/resend-activation-checklist.md.
EMAIL_TEST_MODE=false
